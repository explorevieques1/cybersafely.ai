{
  "permissions": {
    "deny": [
      "Read(./Credentials.md)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./Private/**)",
      "Read(./Notion/Assessment Results & Meaning.md)",
      "Read(./Notion/Capability Starting Profile & Work Tests.md)",
      "Read(./Notion/About Me & My Direction.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-private.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
